{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NODE_ENV",
    "LOG_LEVEL",
    "MONGODB_URI",
    "REDIS_URL",
    "CI_WORKSPACE_ROOT",
    "CI_STEP_TIMEOUT_MS",
    "CI_TOTAL_TIMEOUT_MS",
    "CI_MAX_OUTPUT_BYTES",
    "CI_LEASE_MS",
    "CI_CONCURRENCY",
    "RELEASE_SSH_HOST",
    "RELEASE_SSH_PORT",
    "RELEASE_SSH_USER",
    "RELEASE_SSH_PRIVATE_KEY_PATH",
    "RELEASE_SSH_KNOWN_HOSTS_PATH",
    "RELEASE_REMOTE_ROOT",
    "RELEASE_ARTIFACT_ROOT",
    "RELEASE_TIMEOUT_MS",
    "RELEASE_MAX_OUTPUT_BYTES",
    "RELEASE_LEASE_MS",
    "RELEASE_RETENTION",
    "GITHUB_WEBHOOK_SECRET",
    "HOST",
    "PORT"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build", "^typecheck"],
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "lint": {
      "cache": false
    },
    "format:check": {
      "cache": false
    }
  }
}
