{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RunApprovedApiDeployment",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": [
        "arn:aws:ssm:ap-south-1:821656895501:document/ReleaseDeck-DeployApiProduction",
        "arn:aws:ec2:ap-south-1:821656895501:instance/i-0dcc195cf171e3fee"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-south-1"
        }
      }
    },
    {
      "Sid": "ReadApprovedApiDeploymentResult",
      "Effect": "Allow",
      "Action": "ssm:GetCommandInvocation",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-south-1"
        }
      }
    }
  ]
}
