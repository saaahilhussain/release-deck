{
  "name": "@releasedeck/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "rollback": "node dist/rollback-cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "tsx --test src/*.test.ts"
  },
  "dependencies": {
    "@releasedeck/ci-runner": "workspace:*",
    "@releasedeck/db": "workspace:*",
    "@releasedeck/queue": "workspace:*",
    "@releasedeck/release-deployer": "workspace:*",
    "@releasedeck/runtime": "workspace:*"
  },
  "devDependencies": {
    "@releasedeck/tsconfig": "workspace:*",
    "@types/node": "^24.10.1",
    "tsx": "^4.20.5",
    "typescript": "^6.0.3"
  }
}
