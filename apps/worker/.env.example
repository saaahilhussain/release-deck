NODE_ENV=development
LOG_LEVEL=info
MONGODB_URI=mongodb://127.0.0.1:27017/releasedeck
REDIS_URL=redis://127.0.0.1:6379
# Strict OpenSSH target configuration. Replace these safe placeholders.
RELEASE_SSH_HOST=target.example.com
RELEASE_SSH_PORT=22
RELEASE_SSH_USER=deployer
RELEASE_SSH_PRIVATE_KEY_PATH=C:\\Users\\you\\.ssh\\releasedeck_ed25519
RELEASE_SSH_KNOWN_HOSTS_PATH=C:\\Users\\you\\.ssh\\known_hosts
RELEASE_REMOTE_ROOT=/srv/apps
# Omit RELEASE_ARTIFACT_ROOT to use the OS temporary directory.
RELEASE_ARTIFACT_ROOT=C:\\Users\\you\\AppData\\Local\\Temp\\releasedeck-artifacts
RELEASE_TIMEOUT_MS=600000
RELEASE_MAX_OUTPUT_BYTES=65536
RELEASE_LEASE_MS=60000
RELEASE_RETENTION=5
# Target application health endpoint; use the target's loopback HTTP port.
RELEASE_HEALTH_URL=http://127.0.0.1:3000/health
RELEASE_HEALTH_ATTEMPTS=5
RELEASE_HEALTH_INTERVAL_MS=1000
RELEASE_HEALTH_REQUEST_TIMEOUT_MS=2000
# Omit CI_WORKSPACE_ROOT to use the OS temporary directory.
CI_STEP_TIMEOUT_MS=300000
CI_TOTAL_TIMEOUT_MS=1800000
CI_MAX_OUTPUT_BYTES=1048576
CI_LEASE_MS=60000
CI_CONCURRENCY=1
