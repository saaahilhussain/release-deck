{
  "name": "@releasedeck/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "tsx --test src/*.test.ts",
    "credential:hash": "pnpm run build && node dist/hash-operator-password.js"
  },
  "dependencies": {
    "@releasedeck/db": "workspace:*",
    "@releasedeck/queue": "workspace:*",
    "@releasedeck/runtime": "workspace:*",
    "express": "^5.1.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@releasedeck/tsconfig": "workspace:*",
    "@types/express": "^5.0.3",
    "@types/node": "^24.10.1",
    "tsx": "^4.20.5",
    "typescript": "^6.0.3"
  }
}
