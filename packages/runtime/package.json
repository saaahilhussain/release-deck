{
  "name": "@releasedeck/runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "tsx --test src/*.test.ts"
  },
  "dependencies": {
    "dotenv": "^17.2.2",
    "ioredis": "^5.7.0",
    "pino": "^9.9.5",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@releasedeck/tsconfig": "workspace:*",
    "@types/node": "^24.10.1",
    "tsx": "^4.20.5",
    "typescript": "^6.0.3"
  }
}
